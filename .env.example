# Durable production data. The demo adapter runs without this value.
DATABASE_URL=postgres://showout:showout@localhost:5433/showout
AUTH_SECRET=replace-with-at-least-32-random-characters
PILOT_LOGIN_ENABLED=false
PILOT_ACCESS_CODE=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional exact browser origin for a separately hosted Expo web client.
EXPO_WEB_ORIGIN=

# S3-compatible direct uploads (optional in local development)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=showout-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_CDN_URL=

# Runtime data is PostgreSQL. Demo content is inserted by `npm run seed`.
DATA_ADAPTER=postgres
STORAGE_ADAPTER=local
LOCAL_UPLOAD_DIR=.data/uploads
